STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

ADMIN_USERNAME=admin
# bcrypt hash; escape every $ as \$ (Next.js expands $VARS in env files)
ADMIN_PASSWORD_HASH=

SITE_NAME=Asif Academy

# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=

# Optional: public base URL for Stripe success/cancel redirects
# SITE_URL=https://example.com
