# Still required with Payment Links: the site uses it to confirm with Stripe that a payment was made
# before showing the enrolment form. A restricted key with read access to Checkout Sessions is enough.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Email address used to sign in to /admin
ADMIN_EMAIL=you@example.com
# bcrypt hash; escape every $ as \$ (Next.js expands $VARS in env files)
ADMIN_PASSWORD_HASH=

SITE_NAME=Asif Fashion Academy

# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=

# Public base URL for Stripe success/cancel redirects. Set it on the live host; leave unset locally.
# SITE_URL=https://www.asiffashionacademy.com

# Postgres connection string (Railway: Postgres service -> Variables -> DATABASE_PUBLIC_URL).
# Use DATABASE_URL instead only when the site itself is deployed on Railway (private network).
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/railway